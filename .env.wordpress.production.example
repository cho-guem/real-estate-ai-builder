# ============================================================
# WordPress deployment worker production environment
# Copy this file on the worker server, not Vercel.
# Never commit real secrets.
# ============================================================

# Supabase service-role access for reading/writing deployment queue rows
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Real execution gate
REAL_DEPLOYMENT=true
WORDPRESS_DEPLOYMENT_MODE=real
WORDPRESS_WORKER_DRY_RUN=false
WORDPRESS_REQUIRE_DEPLOYMENT_CONFIRMATION=true
WORDPRESS_WORKER_MAX_JOBS=1

# cPanel / ChemiCloud WordPress installation
WORDPRESS_TARGET_PATH=/home/your-cpanel-user/public_html
WORDPRESS_WPCLI_BIN=wp
WORDPRESS_ADMIN_PASSWORD=replace-with-generated-strong-password

# Deployment assets available on the worker server
WORDPRESS_PLUGIN_PACKAGE_PATH=/home/your-cpanel-user/deploy-assets/ai-real-estate-property-manager-wizard.zip
WORDPRESS_ELEMENTOR_TEMPLATE_PATH=/home/your-cpanel-user/deploy-assets/elementor-template.json

# Defaults used when a deployment plan does not override them
WORDPRESS_DEFAULT_ADMIN_USERNAME=site-admin
WORDPRESS_DEFAULT_ADMIN_EMAIL=admin@example.com

# Optional domain provider integration
DOMAIN_PROVIDER=
DOMAIN_PROVIDER_API_TOKEN=

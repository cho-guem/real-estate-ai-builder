# ============================================================
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.
# ============================================================

# Supabase — https://supabase.com/dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Real Estate AI Builder"

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# Supabase auth email redirect (set to your prod domain before deploying)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WordPress auto-deployment
# mock: record deployment plans only
# docker: worker provisions WordPress through Docker + WP-CLI
# wp_cli: worker provisions against an existing server with WP-CLI
# managed_host: worker delegates provisioning to a hosting provider adapter
WORDPRESS_DEPLOYMENT_PROVIDER=mock
WORDPRESS_PLUGIN_PACKAGE_PATH=ai-real-estate-property-manager-wizard.zip
WORDPRESS_ELEMENTOR_TEMPLATE_PATH=elementor-template.json
WORDPRESS_WPCLI_BIN=wp
WORDPRESS_DOCKER_NETWORK=real-estate-builder
WORDPRESS_DEFAULT_ADMIN_USERNAME=site-admin
WORDPRESS_DEFAULT_ADMIN_EMAIL=admin@example.com
WORDPRESS_ADMIN_PASSWORD=replace-with-generated-worker-only-password

# Worker runtime
# Keep false until each Supabase deployment row has explicit confirmation:
# input.deploymentConfirmed=true or input.confirmationStatus=confirmed.
REAL_DEPLOYMENT=false
WORDPRESS_DEPLOYMENT_MODE=dry_run
WORDPRESS_REQUIRE_DEPLOYMENT_CONFIRMATION=true
WORDPRESS_WORKER_DRY_RUN=true
WORDPRESS_WORKER_MAX_JOBS=3
# Preflight checks this path and its wp-config.php before real deployment.
WORDPRESS_TARGET_PATH=/home/your-cpanel-user/public_html

# Domain provider credentials should be stored only in server/worker env.
DOMAIN_PROVIDER=
DOMAIN_PROVIDER_API_TOKEN=
